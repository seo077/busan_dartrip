# 부산 Dartrip — 환경변수 예시
#
# 이 파일을 `.env.local` 로 복사한 뒤 실제 값을 채우십시오.
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# `.env.local` 은 저장소에 올라가지 않습니다(.gitignore).
# 배포 환경(Vercel)에는 같은 이름으로 프로젝트 설정 > Environment Variables 에 등록합니다.
#
# 키 관리 규칙의 정본은 설계 문서 `API데이터설계.md` §2 입니다.
#   NEXT_PUBLIC_ 접두가 붙은 값만 브라우저로 전달됩니다. 나머지는 서버 전용입니다.

# ── 서버 전용 ─────────────────────────────────────────────────────────────────
# 공공데이터포털 서비스키 (관광공사 4종 · 부산명소 · 국가유산 · 모범음식점 공통)
#   포털 마이페이지의 "일반 인증키"를 넣습니다.
#   Encoding 값(%2B·%3D 등이 섞인 형태)과 Decoding 값 어느 쪽을 넣어도 동작합니다.
DATA_GO_KR_KEY=

# Supabase service_role 키 — 서버에서만 사용. 브라우저로 절대 내보내지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 REST 키 (역지오코딩 등 서버 호출용)
KAKAO_REST_KEY=

# Vercel Cron 보호 토큰. 크론 요청의 Authorization 헤더와 대조합니다.
#   임의의 긴 문자열을 직접 정하면 됩니다.
CRON_SECRET=

# ── 브라우저 노출 ─────────────────────────────────────────────────────────────
# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon 키 — 공개 가능. 행 수준 보안(RLS)으로 보호합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 JavaScript 앱키 — 공개 값이므로 카카오 개발자 콘솔에서 도메인 제한을 반드시 겁니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 선택 값 ───────────────────────────────────────────────────────────────────
# 관광공사 지역코드(부산). 비워 두면 6을 씁니다.
#   `areaCode2` 응답으로 확인한 뒤 값이 다르면 여기서 덮어씁니다.
# TOUR_API_AREA_CODE=6
